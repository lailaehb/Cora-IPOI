@page "/nueva/foto"
@inherits PaginaCora
@inject ServicioIA IA

@* HACER UNA FOTO: abre la cámara del móvil, la IA reconoce la prenda y el usuario revisa los datos. *@
<div class="pantalla">
    <div class="contenido">
        @if (foto == null)
        {
            <Cabecera Volver="true" Titulo="Hacer una foto" />
            <div class="visor-foto">
                <p>Pon la prenda sobre un fondo liso, con buena luz, y que ocupe casi toda la foto</p>
                <span class="marco"></span>
                <span class="percha-tenue">@Iconos.PerchaGrande</span>
            </div>
            @* En el móvil, capture="environment" abre directamente la cámara trasera *@
            <label class="disparador" aria-label="Hacer la foto">
                <InputFile OnChange="Elegir" accept="image/*" capture="environment" class="oculto" />
            </label>
            <label class="enlace-acento centrado">
                @Iconos.Imagen Elegir de la galería
                <InputFile OnChange="Elegir" accept="image/*" class="oculto" />
            </label>
            if (fallo)
            {
                <Caja Tipo="error" Texto="No se ha podido abrir la foto. Prueba con otra." />
            }
        }
        else if (analizando)
        {
            <Cabecera Volver="true" Titulo="Revisa la prenda" />
            <section class="tarjeta">
                <img class="foto-nueva pensando" src="@foto" alt="Tu foto" />
                <div class="analizando" aria-live="polite">@Iconos.Chispa <span>@(E.D.Ajustes.Espera == "clasica" ? "Cargando…" : MensajesFoto[paso])</span></div>
            </section>
        }
        else
        {
            <Cabecera Volver="true" Titulo="Revisa la prenda" Sub="Completa los datos para que Cora la tenga en cuenta" />
            if (sugerencia == null)
            {
                <Caja Texto="@(IA.ExplicarError() + " Rellena los datos a mano.")" />
            }
            else if (!sugerencia.EsPrenda)
            {
                <Caja Tipo="error" Texto="No veo ninguna prenda en la foto. Puedes repetirla o rellenar los datos a mano." />
            }
            else
            {
                <Caja Tipo="ok" Texto="He rellenado los datos a partir de la foto. Revísalos antes de guardar." />
            }
            <FormPrenda @key="foto" Foto="@foto" Sugerencia="@sugerencia" />
            <label class="enlace-acento centrado">
                @Iconos.Camara Repetir la foto
                <InputFile OnChange="Elegir" accept="image/*" capture="environment" class="oculto" />
            </label>
        }
    </div>
</div>

@code {
    string? foto;
    bool fallo, analizando;
    // Reto 3: mientras la IA mira la foto, el mensaje va contando qué hace
    static readonly string[] MensajesFoto = { "Cora está mirando tu foto…", "Reconociendo la prenda…", "Fijándome en el color…", "Eligiendo la categoría…" };
    int paso;
    SugerenciaPrenda? sugerencia;

    async Task Elegir(InputFileChangeEventArgs e)
    {
        var f = await Fotos.LeerAsync(e.File);
        fallo = f == null;
        if (f == null) return;
        foto = f;
        sugerencia = null;
        analizando = true;
        paso = 0;
        StateHasChanged();
        var tarea = IA.AnalizarFotoAsync(f);
        var inicio = DateTime.Now;
        // Como mínimo se ven todos los mensajes (unos 2,4 s); si la IA tarda más, se queda en el último
        while ((DateTime.Now - inicio).TotalMilliseconds < 2400 || !tarea.IsCompleted)
        {
            await Task.Delay(150);
            paso = Math.Min(MensajesFoto.Length - 1, (int)((DateTime.Now - inicio).TotalMilliseconds / 650));
            StateHasChanged();
        }
        sugerencia = await tarea;
        analizando = false;
    }
}
