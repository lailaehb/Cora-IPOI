@page "/prenda/{Id}"
@inherits PaginaCora
@using System.Globalization

@* FICHA DE LA PRENDA: datos, favorita y estado de la lavadora. *@
<div class="pantalla">
    <div class="contenido">
        <Cabecera Volver="true" Titulo="Ficha de la prenda" />
        @if (P == null)
        {
            <Caja Tipo="error" Texto="Esta prenda ya no está en tu armario." />
        }
        else
        {
            <div class="fila heroe">
                <div class="foto-heroe"><FotoPrenda P="P" /></div>
                <div class="crece"><h2>@P.Nombre</h2><p class="sec">@P.Marca</p></div>
                <button class="corazon @(E.EsFavorita(P.Id) ? "on" : "")" aria-pressed="@(E.EsFavorita(P.Id) ? "true" : "false")"
                        aria-label="Favorita" @onclick="() => E.AlternarFavoritaAsync(P.Id)">@Iconos.Corazon(E.EsFavorita(P.Id))</button>
            </div>
            <section class="tarjeta datos">
                <div><span>Categoría</span><span>@(DatosEjemplo.NombreCat[P.Cat]) · @P.Sub</span></div>
                <div><span>Color</span><span>@(string.IsNullOrEmpty(P.Color) ? "—" : P.Color)</span></div>
                <div><span>Talla</span><span>@(string.IsNullOrEmpty(P.Talla) ? "—" : P.Talla)</span></div>
                <div><span>Marca</span><span>@(string.IsNullOrEmpty(P.Marca) ? "—" : P.Marca)</span></div>
            </section>
            <section class="tarjeta">
                <h3>¿Para qué la usas?</h3>
                <p class="sec">Cora solo te la propondrá para estos planes.</p>
                <div class="chips">
                    @for (int f = 0; f < ServicioIA.Usos.Length; f++)
                    {
                        var nivel = f;
                        <Chip Texto="@ServicioIA.Usos[nivel]" Activo="@P.Encaja(nivel)" OnClick="@(() => CambiarUso(nivel))" />
                    }
                </div>
                <small class="sec">Se marcan seguidos, de lo más cómodo a lo más arreglado.</small>
            </section>
            <section class="tarjeta">
                @if (P.Lavando)
                {
                    bool seca = Estado.Seca(P);
                    <div class="fila">@Iconos.Lavadora <h3>@(seca ? "Ya debería estar seca" : "En la lavadora")</h3></div>
                    <p class="sec">@(seca ? "Ya ha pasado el tiempo que elegiste al poner la lavadora." : $"Quedan {Estado.TextoFalta(Estado.Falta(P))} · Estará seca {FinTexto}")</p>
                    @* La barra avanza con las horas reales (se actualiza cada 30 segundos) *@
                    <div class="progreso @(seca ? "completo" : "")" role="progressbar" aria-label="Lavado y secado"
                         aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)(Estado.FraccionLavado(P) * 100))">
                        <div style="width:@Estado.AnchoLavado(P)"></div>
                    </div>
                    <button class="btn" @onclick="Disponible">Marcar como disponible</button>
                    <Caja Tipo="@(seca ? "ok" : "info")" Texto="@(seca ? "Cuando la tengas en el armario, márcala como disponible y Cora volverá a usarla en tus conjuntos." : "Mientras se lava, Cora no la tendrá en cuenta en tus conjuntos. Te avisaré cuando esté seca.")" />
                }
                else if (P.EnCesto)
                {
                    <div class="fila">@Iconos.Cesto <h3>En el cesto</h3></div>
                    <p class="sec">Está sucia, así que Cora no la usará en tus conjuntos. Irá a la lavadora con el resto del cesto.</p>
                    <a class="btn" href="cesto">Ir al cesto</a>
                    <button class="btn secundario" @onclick="SacarDelCesto">Sacar del cesto</button>
                }
                else
                {
                    <h3>Disponible</h3>
                    <p class="sec">Cora la puede usar en tus conjuntos.</p>
                    <button class="btn secundario" @onclick="AlCesto">@Iconos.Cesto Echar al cesto</button>
                }
            </section>
            if (!confirmarBorrado)
            {
                <button class="enlace" @onclick="() => confirmarBorrado = true">Borrar prenda</button>
            }
            else
            {
                <Caja Tipo="error" Texto="@($"¿Seguro que quieres borrar «{P.Nombre}» de tu armario?")" />
                <div class="fila">
                    <button class="btn secundario" @onclick="() => confirmarBorrado = false">Cancelar</button>
                    <button class="btn peligro" @onclick="Borrar">Borrar</button>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public string Id { get; set; } = "";
    bool confirmarBorrado;

    Prenda? P => E.PrendaPorId(Id);
    /// <summary>«hoy a las 18:30», «mañana a las 9:05» o «el jueves a las 12:00».</summary>
    string FinTexto
    {
        get
        {
            if (P == null) return "";
            var f = Estado.FinLavado(P);
            int dif = (f.Date - DateTime.Today).Days;
            string dia = dif == 0 ? "hoy" : dif == 1 ? "mañana" : "el " + Fechas.Dias[(int)f.DayOfWeek];
            return $"{dia} a las {f.ToString("H:mm", CultureInfo.InvariantCulture)}";
        }
    }

    async Task CambiarUso(int nivel)
    {
        if (P == null) return;
        var r = ServicioIA.AlternarUso(P.FormMin, P.FormMax, nivel);
        if (r == null) { E.MostrarAviso("Para quitar ese uso, quita antes los de los extremos."); return; }
        if (r.Value.Min < 0) { E.MostrarAviso("La prenda tiene que servir para algún plan."); return; }
        await E.CambiarUsosAsync(Id, r.Value.Min, r.Value.Max);
    }

    async Task AlCesto()
    {
        await E.EcharAlCestoAsync(new[] { Id });
        E.MostrarAviso("Al cesto. Cuando pongas la lavadora, irá con el resto.");
    }

    async Task SacarDelCesto()
    {
        await E.SacarDelCestoAsync(new[] { Id });
        E.MostrarAviso("Fuera del cesto: disponible de nuevo");
    }

    async Task Disponible()
    {
        await E.CambiarLavadoAsync(new[] { Id }, false);
        E.MostrarAviso("Disponible de nuevo");
    }

    async Task Borrar()
    {
        await E.BorrarPrendaAsync(Id);
        await E.Atras();
    }
}
