@page "/explorar"
@inherits PaginaCora

@* EXPLORAR: outfits de otras personas.
   · Todo: personas que quizá te gusten + todas las publicaciones.
   · Outfits: solo los conjuntos, en rejilla, para verlos de un vistazo.
   · Personas: la lista de personas para seguirlas o ver su perfil. *@
<div class="pantalla">
    <div class="contenido">
        <Cabecera Titulo="Explorar" Sub="Inspírate con los conjuntos de otras personas" Avatar="true" />
        <div class="chips" role="group" aria-label="Qué ver">
            @foreach (var f in new[] { "Todo", "Outfits", "Personas" })
            {
                var filtroChip = f;
                <Chip Texto="@filtroChip" Activo="@(filtro == filtroChip)" OnClick="@(() => filtro = filtroChip)" />
            }
        </div>

        @if (filtro == "Todo")
        {
            <div class="seccion"><h2>Personas que quizá te gusten</h2><button class="enlace" @onclick="@(() => filtro = "Personas")">Ver todas</button></div>
            <div class="personas-sugeridas">
                @foreach (var per in DatosEjemplo.Personas)
                {
                    var pe = per;
                    bool sigo = E.Sigo(pe.Usuario);
                    <div class="persona-mini">
                        <a href="@($"persona/{pe.Usuario}")" class="persona-enlace centro">
                            <span class="avatar">@(pe.Nombre[..1])</span>
                            <b>@pe.Nombre</b>
                            <small class="sec">@pe.Estilos[0]</small>
                        </a>
                        <button class="seguir @(sigo ? "on" : "")" aria-pressed="@(sigo ? "true" : "false")" @onclick="() => E.AlternarSeguirAsync(pe.Usuario)">@(sigo ? "✓ Siguiendo" : "Seguir")</button>
                    </div>
                }
            </div>
            <div class="seccion"><h2>Últimos outfits</h2></div>
            @foreach (var pub in DatosEjemplo.Publicaciones)
            {
                <TarjetaPublicacion P="pub" @key="pub.Id" />
            }
        }
        else if (filtro == "Outfits")
        {
            <div class="rejilla-outfits">
                @foreach (var pub in DatosEjemplo.Publicaciones)
                {
                    <MiniOutfit P="pub" @key="pub.Id" />
                }
            </div>
        }
        else
        {
            <div class="lista-personas">
                @foreach (var per in DatosEjemplo.Personas)
                {
                    var pe = per;
                    bool sigo = E.Sigo(pe.Usuario);
                    int n = DatosEjemplo.Publicaciones.Count(x => x.Usuario == pe.Usuario);
                    <div class="tarjeta fila persona-fila">
                        <a href="@($"persona/{pe.Usuario}")" class="fila crece persona-enlace">
                            <span class="avatar">@(pe.Nombre[..1])</span>
                            <span class="crece"><b>@pe.Nombre</b><small class="sec bloque">@("@")@pe.Usuario · @n @(n == 1 ? "outfit" : "outfits")</small></span>
                        </a>
                        <button class="seguir @(sigo ? "on" : "")" aria-pressed="@(sigo ? "true" : "false")" @onclick="() => E.AlternarSeguirAsync(pe.Usuario)">@(sigo ? "✓ Siguiendo" : "Seguir")</button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    string filtro = "Todo";
}
