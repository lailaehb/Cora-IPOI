@page "/nueva/qr"
@inherits PaginaCora
@inject IJSRuntime JS
@inject ServicioProducto Producto
@using System.Text.Json

@* RETO 1: escanear el QR de la etiqueta con confirmación por imagen, sonido y vibración.
   Estados: buscando → leído (verde, ✓, pitido + vibración) o error (rojo, dos tonos + vibración y cómo arreglarlo). *@
<div class="pantalla">
    <div class="contenido">
        <Cabecera Volver="true" Titulo="Escanear etiqueta" />

        <div class="visor @Clase" aria-live="polite">
            @if (fase == Fase.Buscando && directo)
            {
                <video id="video-qr" muted playsinline></video>
            }
            <span class="esquinas"></span>
            @if (fase == Fase.Leido)
            {
                <span class="sello">@Iconos.Check</span>
            }
            else if (fase == Fase.Error)
            {
                <span class="sello">!</span>
            }
            else if (!directo)
            {
                <span class="qr-tenue">@Iconos.Qr</span>
            }
            <span class="estado">@TextoEstado</span>
        </div>

        @if (fase == Fase.Buscando)
        {
            if (!directo)
            {
                <label class="btn">
                    @Iconos.Camara Hacer una foto a la etiqueta
                    <InputFile OnChange="LeerFoto" accept="image/*" capture="environment" class="oculto" />
                </label>
            }
            if (sinPermiso)
            {
                <Caja Tipo="error" Texto="No hay permiso para usar la cámara. Actívalo en los ajustes del navegador, o usa «Hacer una foto a la etiqueta»." />
            }
            <Caja Texto="Al leerla sonará un pitido (y el móvil vibrará si es Android). También vale el QR o el enlace de un producto de Zara, Mango, H&amp;M y otras tiendas." />
            <button class="enlace" @onclick="Simular">Simular una lectura (sin etiqueta)</button>
        }
        else if (fase == Fase.Error)
        {
            <Caja Tipo="error" Texto="@($"{tituloError} {textoError}")" />
            <button class="btn" @onclick="Reintentar">Volver a intentarlo</button>
        }
        else if (leida != null)
        {
            <Caja Tipo="ok" Texto="@TextoLeido" />
            <section class="tarjeta">
                <div class="fila">
                    <div class="foto-peque @(buscandoFoto ? "cargando" : "")" aria-busy="@buscandoFoto"><FotoPrenda P="leida" Apagada="buscandoFoto" /></div>
                    <div class="crece"><h3>@leida.Nombre</h3><p class="sec">@leida.Marca · @leida.Sub</p></div>
                </div>
                <label class="campo"><span>Nombre</span><input @bind="leida.Nombre" /></label>
                <div class="dos">
                    <label class="campo"><span>Marca</span><input @bind="leida.Marca" /></label>
                    <label class="campo"><span>Talla</span><input @bind="leida.Talla" /></label>
                </div>
                <label class="campo"><span>Color</span><input @bind="leida.Color" /></label>
                <span class="etq">Categoría</span>
                <div class="chips">
                    @foreach (var c in Enum.GetValues<Categoria>())
                    {
                        var cat = c;
                        <Chip Texto="@(DatosEjemplo.NombreCorto[cat])" Activo="@(leida.Cat == cat)" OnClick="@(() => CambiarTipo(cat, DatosEjemplo.Subcategorias[cat][0]))" />
                    }
                </div>
                <span class="etq">Tipo</span>
                <div class="chips">
                    @foreach (var s in DatosEjemplo.Subcategorias[leida.Cat])
                    {
                        var sub = s;
                        <Chip Texto="@sub" Activo="@(leida.Sub == sub)" OnClick="@(() => CambiarTipo(leida.Cat, sub))" />
                    }
                </div>
                <label class="btn secundario">
                    @Iconos.Camara @(leida.Foto == null || leida.Foto.StartsWith("data:image/svg") ? "Hacer una foto a la prenda (opcional)" : "Cambiar la foto")
                    <InputFile OnChange="HacerFoto" accept="image/*" capture="environment" class="oculto" />
                </label>
                <button class="btn" @onclick="Guardar">Guardar en mi armario</button>
                <button class="enlace" @onclick="Reintentar">Escanear otra</button>
            </section>
        }
    </div>
</div>

@code {
    enum Fase { Buscando, Leido, Error }
    Fase fase = Fase.Buscando;
    bool directo;          // cámara en directo (solo en https o localhost)
    bool arrancar;         // hay que encender la cámara después de pintar
    bool sinPermiso;
    Prenda? leida;
    /// <summary>Nombre de la tienda si el QR era un enlace de su web (Zara, Mango…); null si era una etiqueta de Cora.</summary>
    string? tienda;
    string tituloError = "", textoError = "";
    /// <summary>Enlace de la tienda leído en el QR (para descargar su foto).</summary>
    string? enlace;
    bool buscandoFoto;
    /// <summary>null mientras no se sabe; true si se ha traído la foto de la tienda; false si no se ha podido.</summary>
    bool? fotoTienda;
    /// <summary>Cuenta las lecturas, para no poner la foto de una prenda en otra si se escanea otra mientras tanto.</summary>
    int lectura;
    DotNetObjectReference<NuevaQr>? yo;

    string TextoLeido => tienda == null
        ? "Revisa los datos antes de guardar. Puedes corregir lo que haga falta."
        : buscandoFoto ? $"QR de {tienda}: buscando la foto de la prenda en su web…"
        : fotoTienda == true ? $"QR de {tienda}: he traído la foto y los datos de la prenda. Revisa el tipo antes de guardar."
        : $"QR de {tienda}: he sacado los datos del enlace. {Producto.ExplicarError()} Si quieres, hazle tú una foto.";

    string Clase => fase switch { Fase.Leido => "ok", Fase.Error => "error", _ => directo ? "directo" : "" };
    string TextoEstado => fase switch
    {
        Fase.Leido => "Etiqueta leída",
        Fase.Error => "No se ha podido leer",
        _ => directo ? "Coloca el código QR dentro del cuadro" : "Haz una foto al código QR de la etiqueta",
    };

    protected override async Task OnAfterRenderAsync(bool primeraVez)
    {
        if (primeraVez)
        {
            yo = DotNetObjectReference.Create(this);
            try { directo = await JS.InvokeAsync<bool>("cora.qr.camaraDisponible"); } catch { directo = false; }
            arrancar = directo;
            StateHasChanged();
            return;
        }
        if (arrancar && fase == Fase.Buscando && directo)
        {
            arrancar = false;
            var r = await JS.InvokeAsync<string>("cora.qr.iniciar", "video-qr", yo);
            if (r != "ok") { directo = false; sinPermiso = r == "sin-permiso"; StateHasChanged(); }
        }
    }

    /// <summary>Lo llama el JavaScript cuando la cámara encuentra un QR.</summary>
    [JSInvokable]
    public async Task QrLeido(string texto)
    {
        await Procesar(texto);
        StateHasChanged();
    }

    async Task LeerFoto(InputFileChangeEventArgs e)
    {
        var dataUrl = await Fotos.LeerAsync(e.File, 1200);
        string? texto = dataUrl == null ? null : await JS.InvokeAsync<string?>("cora.qr.leerImagen", dataUrl);
        if (texto == null)
        {
            Error("No encontramos un código QR en la foto.", "Acerca la etiqueta para que el código ocupe casi toda la foto, con buena luz y sin reflejos.");
            await E.SonarAsync("error");
            return;
        }
        await Procesar(texto);
    }

    async Task Procesar(string texto)
    {
        tienda = null;
        enlace = null;
        fotoTienda = null;
        buscandoFoto = false;
        lectura++;
        var p = LeerEtiqueta(texto);
        if (p == null && LeerEnlaceTienda(texto) is var (deTienda, marca) && deTienda != null)
        {
            p = deTienda;
            tienda = marca;
            enlace = texto.Trim();
        }
        if (p == null)
        {
            Error("Este código no es de una prenda.", "Cora entiende los QR de las etiquetas de Cora y los enlaces de producto de cualquier tienda online. Prueba con otro.");
            await E.SonarAsync("error");
            return;
        }
        if (E.PrendaPorId(p.Id) != null)
        {
            Error($"{p.Nombre} ya está en tu armario.", "No hace falta añadirla otra vez. Puedes escanear otra prenda.");
            await E.SonarAsync("error");
            return;
        }
        leida = p;
        fase = Fase.Leido;
        await E.SonarAsync("leido");
        if (enlace != null) _ = TraerFotoTienda(p, enlace, lectura);
    }

    /// <summary>Descarga la foto del producto desde la web de la tienda (a través de /api/producto).</summary>
    async Task TraerFotoTienda(Prenda p, string url, int mia)
    {
        buscandoFoto = true;
        StateHasChanged();
        var r = await Producto.BuscarAsync(url);
        string? foto = null;
        if (r?.Foto != null)
        {
            try { foto = await JS.InvokeAsync<string?>("cora.qr.reducirImagen", r.Foto, 480); } catch { foto = null; }
        }
        if (mia != lectura || leida != p) return; // ya se está con otra prenda
        buscandoFoto = false;
        // Si el usuario ya le ha hecho su propia foto mientras tanto, se respeta la suya
        bool sinFotoPropia = p.Foto == null || p.Foto.StartsWith("data:image/svg");
        if (foto != null && sinFotoPropia) p.Foto = foto;
        fotoTienda = foto != null;
        // Si el enlace no traía nombre («Prenda de Zara»), se usa el título de la página
        if (!string.IsNullOrWhiteSpace(r?.Titulo) && p.Nombre.StartsWith("Prenda de ")) p.Nombre = r!.Titulo!;
        // Si la tienda no era de las conocidas, se usa el nombre que da su propia web (og:site_name), si es corto
        var nombreWeb = r?.Tienda?.Trim();
        if (!EsConocida(p.Marca) && !string.IsNullOrWhiteSpace(nombreWeb) && nombreWeb.Length <= 30)
        {
            if (p.Nombre == $"Prenda de {p.Marca}") p.Nombre = $"Prenda de {nombreWeb}";
            p.Marca = nombreWeb;
            tienda = nombreWeb;
        }
        StateHasChanged();
    }

    void Error(string titulo, string texto)
    {
        tituloError = titulo;
        textoError = texto;
        fase = Fase.Error;
    }

    /// <summary>Comprueba que el QR es una etiqueta de Cora: {"cora":1,"id":…,"n":…,"t":…}.</summary>
    static Prenda? LeerEtiqueta(string texto)
    {
        try
        {
            using var doc = JsonDocument.Parse(texto);
            var j = doc.RootElement;
            if (j.ValueKind != JsonValueKind.Object) return null;
            if (!j.TryGetProperty("cora", out var v) || v.ValueKind != JsonValueKind.Number || v.GetInt32() != 1) return null;
            string S(string k) => j.TryGetProperty(k, out var x) && x.ValueKind == JsonValueKind.String ? x.GetString() ?? "" : "";
            string id = S("id"), nombre = S("n");
            if (id == "" || nombre == "" || !Enum.TryParse<Categoria>(S("t"), true, out var cat)) return null;
            var subs = DatosEjemplo.Subcategorias[cat];
            string sub = subs.Contains(S("sub")) ? S("sub") : subs[0];
            int fmin = 1, fmax = 2, abrigo = 1;
            if (j.TryGetProperty("form", out var f) && f.ValueKind == JsonValueKind.Array && f.GetArrayLength() == 2) { fmin = f[0].GetInt32(); fmax = f[1].GetInt32(); }
            if (j.TryGetProperty("abrigo", out var a) && a.ValueKind == JsonValueKind.Number) abrigo = a.GetInt32();
            return new Prenda { Id = id, Nombre = nombre, Marca = S("m"), Cat = cat, Sub = sub, Color = S("c"), Talla = S("talla"), FormMin = fmin, FormMax = fmax, Abrigo = abrigo };
        }
        catch
        {
            return null;
        }
    }

    // ---------------------------------------------------------------- QR de tiendas (cualquier tienda online)
    // Vale el enlace de cualquier tienda. Esta lista solo sirve para escribir bien el nombre de las conocidas;
    // para las demás, la marca se saca de la dirección (www.asos.com → «Asos») o del nombre que da su web.
    static readonly (string Clave, string Marca)[] Tiendas =
    {
        ("zara.", "Zara"), ("mango.", "Mango"), ("bershka.", "Bershka"), ("pullandbear.", "Pull&Bear"), ("stradivarius.", "Stradivarius"),
        ("massimodutti.", "Massimo Dutti"), ("oysho.", "Oysho"), ("lefties.", "Lefties"), ("hm.com", "H&M"), ("primark.", "Primark"),
        ("uniqlo.", "Uniqlo"), ("shein.", "Shein"), ("nike.", "Nike"), ("adidas.", "Adidas"), ("elcorteingles.", "El Corte Inglés"), ("springfield.", "Springfield"),
        ("cortefiel.", "Cortefiel"), ("asos.", "ASOS"), ("zalando.", "Zalando"), ("decathlon.", "Decathlon"), ("kiabi.", "Kiabi"), ("cos.com", "COS"),
        ("arket.", "Arket"), ("andotherstories.", "& Other Stories"), ("desigual.", "Desigual"), ("tezenis.", "Tezenis"), ("calzedonia.", "Calzedonia"),
        ("intimissimi.", "Intimissimi"), ("levi.", "Levi's"), ("pepejeans.", "Pepe Jeans"), ("tommy.", "Tommy Hilfiger"), ("ralphlauren.", "Ralph Lauren"),
        ("vans.", "Vans"), ("converse.", "Converse"), ("newbalance.", "New Balance"), ("puma.", "Puma"), ("reebok.", "Reebok"), ("thenorthface.", "The North Face"),
        ("primor.", "Primor"), ("amazon.", "Amazon"), ("aliexpress.", "AliExpress"), ("vinted.", "Vinted"), ("wallapop.", "Wallapop"), ("parfois.", "Parfois"),
        ("sfera.", "Sfera"), ("guess.", "Guess"), ("calvinklein.", "Calvin Klein"), ("lacoste.", "Lacoste"), ("benetton.", "Benetton"), ("superdry.", "Superdry"),
    };

    // Trozos de la dirección que no son el nombre de la tienda
    static readonly HashSet<string> NoEsMarca = new() { "www", "www2", "m", "shop", "store", "tienda", "es", "en", "eu", "com", "co", "org", "net", "online" };

    /// <summary>Nombre de la tienda a partir de la dirección: «www.mitienda.es» → «Mitienda».</summary>
    static string MarcaDeHost(string host)
    {
        var conocida = Tiendas.FirstOrDefault(t => host.Contains(t.Clave));
        if (conocida.Marca != null) return conocida.Marca;
        var partes = host.Split('.', StringSplitOptions.RemoveEmptyEntries);
        // Se quita la terminación (.es, .com, .co.uk…) y se coge el trozo con nombre más a la derecha
        var sinFinal = partes.Length > 1 ? partes[..^1] : partes;
        string nombre = Enumerable.Reverse(sinFinal).FirstOrDefault(x => !NoEsMarca.Contains(x) && x.Length > 1) ?? partes[0];
        nombre = nombre.Replace('-', ' ');
        return char.ToUpper(nombre[0]) + nombre[1..];
    }

    /// <summary>True si la marca salió de la lista de tiendas conocidas (está bien escrita).</summary>
    static bool EsConocida(string marca) => Tiendas.Any(t => t.Marca == marca);

    // Palabras del enlace → categoría y tipo (el primero que encaje). Abrigos antes que «punto» para que «chaqueta punto» sea chaqueta.
    static readonly (string Palabra, Categoria Cat, string Sub)[] PorPalabra =
    {
        ("blazer", Categoria.Capa, "Blazers"), ("americana", Categoria.Capa, "Blazers"), ("abrigo", Categoria.Capa, "Abrigos"), ("gabardina", Categoria.Capa, "Abrigos"),
        ("parka", Categoria.Capa, "Abrigos"), ("plumifero", Categoria.Capa, "Abrigos"), ("chaqueta", Categoria.Capa, "Chaquetas"), ("cazadora", Categoria.Capa, "Chaquetas"),
        ("cardigan", Categoria.Capa, "Chaquetas"), ("chaleco", Categoria.Capa, "Chaquetas"), ("jacket", Categoria.Capa, "Chaquetas"), ("coat", Categoria.Capa, "Abrigos"),
        ("zapatilla", Categoria.Calzado, "Zapatillas"), ("deportiva", Categoria.Calzado, "Zapatillas"), ("sneaker", Categoria.Calzado, "Zapatillas"), ("bota", Categoria.Calzado, "Botas"),
        ("botin", Categoria.Calzado, "Botas"), ("tacon", Categoria.Calzado, "Tacones"), ("salon", Categoria.Calzado, "Tacones"), ("sandalia", Categoria.Calzado, "Zapatillas"), ("zapato", Categoria.Calzado, "Zapatillas"),
        ("vaquero", Categoria.Abajo, "Vaqueros"), ("jean", Categoria.Abajo, "Vaqueros"), ("falda", Categoria.Abajo, "Faldas"), ("malla", Categoria.Abajo, "Mallas"), ("legging", Categoria.Abajo, "Mallas"),
        ("short", Categoria.Abajo, "Shorts"), ("bermuda", Categoria.Abajo, "Shorts"), ("pantalon", Categoria.Abajo, "Pantalones"), ("jogger", Categoria.Abajo, "Pantalones"), ("trousers", Categoria.Abajo, "Pantalones"),
        ("sudadera", Categoria.Arriba, "Sudaderas"), ("hoodie", Categoria.Arriba, "Sudaderas"), ("jersey", Categoria.Arriba, "Jerséis"), ("punto", Categoria.Arriba, "Jerséis"), ("sweater", Categoria.Arriba, "Jerséis"),
        ("camisa", Categoria.Arriba, "Camisas"), ("blusa", Categoria.Arriba, "Camisas"), ("shirt", Categoria.Arriba, "Camisetas"), ("camiseta", Categoria.Arriba, "Camisetas"), ("polo", Categoria.Arriba, "Camisetas"),
        ("top", Categoria.Arriba, "Tops"), ("body", Categoria.Arriba, "Tops"),
    };

    static readonly string[] Colores = { "negro", "blanco", "gris", "azul", "rojo", "verde", "beige", "marron", "rosa", "amarillo", "crudo", "burdeos", "camel", "naranja", "morado", "lila", "caqui", "plata", "dorado" };

    /// <summary>
    /// Enlace de producto de una tienda, p. ej. https://www.zara.com/es/es/jersey-punto-cuello-pico-p05693578.html
    /// → «Jersey punto cuello pico», marca Zara, Parte de arriba · Jerséis. Devuelve (null, null) si no lo es.
    /// </summary>
    static (Prenda? Prenda, string? Marca) LeerEnlaceTienda(string texto)
    {
        if (!Uri.TryCreate(texto.Trim(), UriKind.Absolute, out var uri) || (uri.Scheme != "http" && uri.Scheme != "https")) return (null, null);
        string host = uri.Host.ToLowerInvariant();
        var tienda = (Clave: host, Marca: MarcaDeHost(host));

        // El trozo del enlace con el nombre: el más largo con guiones (sin la extensión ni el código del producto)
        var trozos = Uri.UnescapeDataString(uri.AbsolutePath).Replace(' ', ' ').Split('/', StringSplitOptions.RemoveEmptyEntries);
        string referencia = System.Text.RegularExpressions.Regex.Match(uri.AbsolutePath + uri.Query, @"\d{6,}").Value;
        string slug = trozos.Select(t => System.Text.RegularExpressions.Regex.Replace(t, @"\.(html?|aspx)$", ""))
                            .Select(t => System.Text.RegularExpressions.Regex.Replace(t, @"[-_][a-z]?\d{5,}.*$", ""))
                            .Where(t => t.Contains('-') && t.Count(char.IsLetter) >= 5)
                            .OrderByDescending(t => t.Length).FirstOrDefault() ?? "";
        // Ni nombre ni referencia (por ejemplo, la portada de la tienda): no es una prenda
        if (slug == "" && referencia == "") return (null, null);

        string nombre = slug == "" ? $"Prenda de {tienda.Marca}" : System.Text.RegularExpressions.Regex.Replace(slug.Replace('-', ' ').Replace('_', ' '), @"\s+", " ").Trim();
        nombre = char.ToUpper(nombre[0]) + nombre[1..];
        string norm = MotorIA.Normalizar(nombre);

        var (cat, sub) = (Categoria.Arriba, DatosEjemplo.Subcategorias[Categoria.Arriba][0]);
        foreach (var w in PorPalabra) if (norm.Contains(w.Palabra)) { (cat, sub) = (w.Cat, w.Sub); break; }
        string color = Colores.FirstOrDefault(c => System.Text.RegularExpressions.Regex.IsMatch(norm, $@"{c}")) ?? "";

        var def = DatosEjemplo.PorDefecto.TryGetValue(sub, out var d) ? d : (1, 2, 1, true);
        string id = MotorIA.Normalizar(tienda.Marca).Replace(" ", "").Replace("&", "") + "_" + (referencia != "" ? referencia : MotorIA.Normalizar(slug));
        var p = new Prenda
        {
            Id = id, Nombre = nombre, Marca = tienda.Marca, Cat = cat, Sub = sub, Color = color,
            FormMin = def.Item1, FormMax = def.Item2, Abrigo = def.Item3, AptaLluvia = def.Item4,
            Foto = FotoProvisional(tienda.Marca),
        };
        return (p, tienda.Marca);
    }

    /// <summary>Mientras no tenga foto: una percha con el nombre de la tienda.</summary>
    static string FotoProvisional(string marca)
    {
        string svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 140'><rect width='120' height='140' fill='#F3DBE3'/>"
            + "<path d='M60 38a8 8 0 1 0-8-8M60 38v4L22 74a5 5 0 0 0 3 9h70a5 5 0 0 0 3-9L60 42' fill='none' stroke='#8F3F5E' stroke-width='4' stroke-linecap='round' stroke-linejoin='round'/>"
            + $"<text x='60' y='116' font-family='Georgia,serif' font-size='16' font-weight='700' fill='#8F3F5E' text-anchor='middle'>{System.Net.WebUtility.HtmlEncode(marca)}</text></svg>";
        return "data:image/svg+xml;charset=utf-8," + Uri.EscapeDataString(svg);
    }

    void CambiarTipo(Categoria cat, string sub)
    {
        if (leida == null) return;
        leida.Cat = cat;
        leida.Sub = sub;
        if (DatosEjemplo.PorDefecto.TryGetValue(sub, out var d)) { leida.FormMin = d.Min; leida.FormMax = d.Max; leida.Abrigo = d.Abrigo; leida.AptaLluvia = d.Lluvia; }
    }

    async Task HacerFoto(InputFileChangeEventArgs e)
    {
        if (leida == null) return;
        leida.Foto = await Fotos.LeerAsync(e.File) ?? leida.Foto;
    }

    async Task Simular()
    {
        var libre = DatosEjemplo.Etiquetas().FirstOrDefault(l => E.PrendaPorId(l.Id) == null) ?? DatosEjemplo.Etiquetas()[0];
        static string Q(string v) => "\"" + JsonEncodedText.Encode(v) + "\"";
        string json = "{\"cora\":1,\"id\":" + Q(libre.Id) + ",\"n\":" + Q(libre.Nombre) + ",\"m\":" + Q(libre.Marca) + ",\"t\":" + Q(libre.Cat.ToString().ToLower())
            + ",\"sub\":" + Q(libre.Sub) + ",\"c\":" + Q(libre.Color) + ",\"talla\":" + Q(libre.Talla) + "}";
        if (directo) { try { await JS.InvokeVoidAsync("cora.qr.parar"); } catch { } }
        await Procesar(json);
    }

    void Reintentar()
    {
        leida = null;
        lectura++;
        buscandoFoto = false;
        sinPermiso = false;
        fase = Fase.Buscando;
        arrancar = directo;
    }

    async Task Guardar()
    {
        if (leida == null) return;
        var p = leida;
        await E.AnadirPrendaAsync(p);
        Nav.NavigateTo($"categoria/{p.Cat.ToString().ToLower()}", replace: true);
    }

    public override void Dispose()
    {
        base.Dispose();
        _ = JS.InvokeVoidAsync("cora.qr.parar").AsTask().ContinueWith(_ => { });
        yo?.Dispose();
    }
}
