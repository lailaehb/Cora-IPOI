@page "/registro"
@inherits PaginaCora

@* Registro en dos pasos: 1) la cuenta · 2) sobre ti y tu estilo *@
<div class="pantalla">
    <div class="contenido">
        @if (paso == 0)
        {
            <div class="marca">
                <span class="logo grande">Cora</span>
                <p class="sec">tu armario, a tu manera</p>
                <span class="percha">@Iconos.PerchaGrande</span>
            </div>
            <Pasos Actual="0" />
            <section class="tarjeta destacada">
                <PanelFacil />
            </section>
            <h1>Crea tu cuenta</h1>
            <label class="campo"><span>Nombre</span><input @bind="p.Nombre" @bind:event="oninput" autocomplete="given-name" /></label>
            <label class="campo"><span>Correo electrónico</span><input type="email" @bind="p.Email" @bind:event="oninput" autocomplete="email" /></label>
            <label class="campo"><span>Contraseña</span><input type="password" @bind="clave" @bind:event="oninput" autocomplete="new-password" /></label>
            if (!string.IsNullOrEmpty(error))
            {
                <Caja Tipo="error" Texto="@error" />
            }
        }
        else
        {
            <button class="volver" @onclick="() => paso = 0" aria-label="Volver">@Iconos.Atras</button>
            <Pasos Actual="1" />
            <h1>Cuéntanos sobre ti</h1>
            <Caja Texto="Así Cora sabe qué tiempo hace y qué ropa te pega. Podrás cambiarlo en tu perfil." />
            <div class="dos">
                <label class="campo"><span>Edad</span><input inputmode="numeric" maxlength="3" @bind="p.Edad" @bind:event="oninput" /></label>
                <label class="campo"><span>Ciudad</span><input @bind="p.Ciudad" @bind:event="oninput" autocomplete="address-level2" /></label>
            </div>
            if (!string.IsNullOrEmpty(error))
            {
                <Caja Tipo="error" Texto="@error" />
            }
            <div>
                <h3>¿Qué looks sueles llevar?</h3>
                <p class="sec">Toca los que más te pegan, puedes elegir varios.</p>
            </div>
            <ElegirLooks Elegidos="p.Estilos" Cambio="LooksCambiados" />
        }
    </div>
    <footer class="pie">
        @if (paso == 0)
        {
            <button class="btn" @onclick="Continuar">Continuar</button>
            <button class="btn secundario" @onclick="ConGoogle">Continuar con Google</button>
            <button class="enlace" @onclick="Entrar">¿Ya tienes cuenta? Entrar</button>
        }
        else
        {
            <button class="btn" disabled="@comprobando" @onclick="Empezar">@(comprobando ? "Comprobando…" : "Empezar")</button>
        }
    </footer>
</div>

@code {
    int paso;
    Perfil p = new();
    string clave = "", error = "";
    bool comprobando;

    /// <summary>Paso 2: antes de entrar, comprueba que la edad tiene sentido y que la ciudad existe.</summary>
    async Task Empezar()
    {
        error = "";
        comprobando = true;
        var fallo = await E.Tiempo.ValidarAsync(p.Edad, p.Ciudad);
        comprobando = false;
        if (fallo != null) { error = fallo; await E.SonarAsync("error"); return; }
        p.Ciudad = p.Ciudad.Trim();
        await Terminar();
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(p.Nombre) && string.IsNullOrEmpty(p.Email))
        {
            p = E.D.Perfil.Copia();
            // Solo se quedan los looks que existen (los de versiones anteriores, como «Clásico», se quitan)
            p.Estilos.RemoveAll(x => !DatosEjemplo.Estilos.Contains(x));
            if (p.Estilos.Count == 0) p.Estilos.Add("Casual");
        }
    }

    Task LooksCambiados() => E.SonarAsync("tic");

    void Continuar()
    {
        error = "";
        if (string.IsNullOrWhiteSpace(p.Nombre)) error = "Escribe tu nombre.";
        else if (!System.Text.RegularExpressions.Regex.IsMatch(p.Email.Trim(), @"^\S+@\S+\.\S+$")) error = "Escribe un correo válido, por ejemplo pilar@correo.es.";
        else if (clave.Length < 6) error = "La contraseña necesita al menos 6 caracteres.";
        else if (p.Nombre.Trim().Length < 2 || !System.Text.RegularExpressions.Regex.IsMatch(p.Nombre.Trim(), @"^[\p{L}][\p{L} '\-]*$")) error = "El nombre solo puede tener letras.";
        else paso = 1;
    }

    void ConGoogle()
    {
        p.Cuenta = "Google";
        if (string.IsNullOrWhiteSpace(p.Nombre)) p.Nombre = "Pilar";
        if (string.IsNullOrWhiteSpace(p.Email)) p.Email = "pilar@gmail.com";
        paso = 1;
    }

    async Task Entrar()
    {
        if (string.IsNullOrWhiteSpace(p.Nombre)) p.Nombre = "Pilar";
        if (string.IsNullOrWhiteSpace(p.Email)) p.Email = "pilar@correo.es";
        await Terminar();
    }

    async Task Terminar()
    {
        p.Registrada = true;
        p.Gustos = DatosEjemplo.GustosDe(p.Estilos);
        await E.GuardarPerfilAsync(p);
        Nav.NavigateTo("", replace: true);
    }
}
