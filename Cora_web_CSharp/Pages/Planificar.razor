@page "/dia/{Fecha}"
@page "/planificar"
@inherits PaginaCora

@* UN DÍA DEL CALENDARIO: arriba, la ropa de ese día; debajo, le cuentas a Cora tus planes escribiendo o hablando
   (sin botones de planes) y eliges si prepara solo este día o varios (de un día a otro, por ejemplo para un viaje).
   Reto 2 (planificar con IA) y reto 3 (mientras la IA trabaja, huecos grises y el botón cambia de mensaje). *@
<div class="pantalla">
    <div class="contenido">
        <Cabecera Volver="true" Titulo="@Fechas.Etiqueta(elegido)" Sub="@($"{Fechas.Cap(Fechas.Larga(elegido))} · {W.T}° {W.Cielo}")" VolverA="@($"calendario?dia={elegido}")" />

        @* ---- La ropa de ese día ---- *@
        <section class="tarjeta" aria-live="polite">
            <div class="entre"><h2>@E.T("Tu ropa", "Tu ropa")</h2><span class="tiempo-anim @W.Cielo">@ServicioTiempo.Icono(W.Cielo)</span></div>
            @if (E.EsperandoDia(elegido))
            {
                <EsperaIA Mensaje="@E.MensajeEspera" />
            }
            else if (E.PensandoDia == elegido)
            {
                <EsperaIA Mensaje="@E.MensajeOtra" />
            }
            else if (O != null)
            {
                if (!string.IsNullOrEmpty(O.Momento))
                {
                    <h3 class="momento">@O.Momento</h3>
                }
                <FilaOutfit Ids="O.Ids" Catalogo="E.D.Prendas" Animar="@(E.RecienRelleno(elegido))" @key="@(elegido + (E.RecienRelleno(elegido) ? "-nuevo" : ""))" />
                <p class="porque">@O.Porque</p>
                <LooksExtra O="O" Catalogo="E.D.Prendas" />
                if (!Pasado)
                {
                    <div class="fila">
                        <button class="btn secundario bajo extra" disabled="@(E.PensandoDia == elegido)" @onclick="() => E.OtraOpcionAsync(elegido)">@Iconos.Recargar @(E.PensandoDia == elegido ? "Pensando…" : E.T("Otra opción", "Ver otra"))</button>
                        <button class="btn secundario bajo" aria-pressed="@(DiaGuardado ? "true" : "false")" @onclick="() => E.AlternarGuardadoDiaAsync(elegido)">@Iconos.Marcador(DiaGuardado) @(DiaGuardado ? "Guardado ✓" : "Guardar")</button>
                    </div>
                }
                <BorrarOutfit Dia="@elegido" @key="@("borrar-" + elegido)" />
            }
            else
            {
                <p class="sec">@(Pasado ? "Este día no tiene outfit registrado." : "Todavía sin outfit. Cuéntale a Cora qué vas a hacer y te lo prepara.")</p>
            }
        </section>

        @if (!Pasado)
        {
            @* ---- ¿Un día o varios? ---- *@
            <div class="segmentos" role="radiogroup" aria-label="Qué planificar">
                <button role="radio" class="@(!varios ? "on" : "")" aria-checked="@(!varios ? "true" : "false")" @onclick="() => varios = false">Un día</button>
                <button role="radio" class="@(varios ? "on" : "")" aria-checked="@(varios ? "true" : "false")" @onclick="CambiarAVarios">Varios días</button>
            </div>

            @if (!varios)
            {
                <section class="tarjeta">
                    <h2>¿Qué vas a hacer @Cuando(elegido)?</h2>
                    @if (Plan.Claves.Count > 0)
                    {
                        @* Planes marcados con botones en versiones anteriores: se ven y se pueden quitar *@
                        <div class="etiquetas">
                            @foreach (var c in Plan.Claves.ToList())
                            {
                                var clave = c;
                                var tipo = DatosEjemplo.Planes.FirstOrDefault(t => t.Clave == clave);
                                if (tipo != null)
                                {
                                    <button class="pastilla quitar" aria-label="@($"Quitar {tipo.Nombre}")" @onclick="() => E.AlternarPlanAsync(elegido, clave)">@tipo.Nombre ✕</button>
                                }
                            }
                        </div>
                    }
                    <CampoPlan Texto="@Plan.Texto" TextoChanged="Escribir" />
                </section>
            }
            else
            {
                <section class="tarjeta">
                    <div>
                        <h2>¿De qué día a qué día?</h2>
                        <p class="sec">@(eligiendoFin ? "Ahora toca el último día." : "Toca el primer día y luego el último. Perfecto para un viaje.")</p>
                    </div>
                    <div class="tira-dias" id="tira-dias" role="group" aria-label="Elegir días">
                        @foreach (var d in Proximos)
                        {
                            var dia = d;
                            bool dentro = EnRango(dia);
                            string clase = (dentro ? "dentro " : "") + (dia == desde ? "inicio " : "") + (dia == hasta ? "fin " : "") + (Fechas.De(dia).DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday ? "finde" : "");
                            <button class="@clase" aria-pressed="@(dentro ? "true" : "false")" aria-label="@Fechas.Larga(dia)" @onclick="() => TocarDia(dia)">
                                <small>@Fechas.DiaCorto(dia)</small>
                                <b>@Fechas.De(dia).Day</b>
                                <i class="@(E.OutfitDe(dia) != null ? "punto" : E.PlanDe(dia) != null ? "aro" : "")"></i>
                            </button>
                        }
                    </div>
                    <p class="rango-resumen">@Iconos.Calendario <span>@ResumenRango</span></p>
                    <CampoPlan Etiqueta="¿Qué vas a hacer esos días?" Texto="@textoRango" TextoChanged="t => textoRango = t" Placeholder="Por ejemplo: el lunes clase, el martes gimnasio y el miércoles cena" />
                    <small class="sec">Di el día y lo que vas a hacer, y Cora lo reparte. Lo que no lleve día vale para todos.</small>
                </section>

                @* Vista previa: cómo ha repartido Cora el texto, día a día *@
                <section class="tarjeta reparto" aria-live="polite">
                    <h3>@Iconos.Chispa Así lo he entendido</h3>
                    <ul>
                        @foreach (var d in DiasRango)
                        {
                            var (texto, tipo) = PlanPrevisto(d);
                            <li class="@tipo" @key="d">
                                <span class="reparto-dia"><small>@Fechas.DiaCorto(d)</small><b>@Fechas.De(d).Day</b></span>
                                <span class="crece">@texto</span>
                            </li>
                        }
                    </ul>
                </section>
            }
        }
    </div>
    @if (!Pasado)
    {
        <footer class="pie" aria-live="polite">
            @if (E.Generando)
            {
                <div class="btn ocupado">
                    <span>@(Clasica ? "Cargando…" : E.MensajeEspera)</span>
                    @if (!Clasica)
                    {
                        <span class="barra-progreso" style="width:@(E.Progreso)%"></span>
                    }
                </div>
            }
            else
            {
                <button class="btn brillo" @onclick="Generar">@Iconos.Chispa @TextoBoton</button>
            }
        </footer>
    }
</div>

@code {
    [Parameter] public string? Fecha { get; set; }
    [SupplyParameterFromQuery(Name = "dia")] public string? DiaQuery { get; set; }

    const int MaxDias = 14;
    string elegido = Fechas.Hoy;
    bool varios;

    // Varios días: del día «desde» al día «hasta» (los dos incluidos)
    string desde = Fechas.Hoy, hasta = Fechas.Hoy;
    bool eligiendoFin;
    string textoRango = "";

    PlanDia Plan => E.D.Planes.TryGetValue(elegido, out var p) ? p : new PlanDia();
    Outfit? O => E.OutfitDe(elegido);
    Tiempo W => E.Tiempo.De(elegido);
    bool Pasado => Fechas.Dif(elegido) < 0;
    bool DiaGuardado => E.DiaGuardado(elegido);
    bool Clasica => E.D.Ajustes.Espera == "clasica";

    /// <summary>«hoy», «mañana» o «el lunes 16», para escribir frases naturales.</summary>
    static string Cuando(string d) => Fechas.Dif(d) <= 1 ? Fechas.Etiqueta(d).ToLower() : "el " + Fechas.Etiqueta(d).ToLower();

    /// <summary>Los próximos 4 semanas, para elegir el rango.</summary>
    List<string> Proximos => Enumerable.Range(0, 28).Select(i => Fechas.Sumar(Fechas.Hoy, i)).ToList();
    List<string> DiasRango => Enumerable.Range(0, Fechas.Dif(hasta) - Fechas.Dif(desde) + 1).Select(i => Fechas.Sumar(desde, i)).ToList();
    bool EnRango(string d) => string.CompareOrdinal(d, desde) >= 0 && string.CompareOrdinal(d, hasta) <= 0;
    int DiasConPlanPropio => DiasRango.Count(d => TienePlan(d));
    bool TienePlan(string d) => E.D.Planes.TryGetValue(d, out var p) && (p.Claves.Count > 0 || !string.IsNullOrWhiteSpace(p.Texto));

    string ResumenRango
    {
        get
        {
            int n = DiasRango.Count;
            if (n == 1) return $"{Fechas.Cap(Fechas.Larga(desde))} · 1 día";
            return $"Del {Fechas.Etiqueta(desde).ToLower()} al {Fechas.Etiqueta(hasta).ToLower()} · {n} días";
        }
    }

    string TextoBoton => !varios
        ? (O != null ? $"Preparar otro outfit para {Cuando(elegido)}" : $"Preparar el outfit de {Cuando(elegido)}")
        : DiasRango.Count == 1 ? "Preparar 1 día" : $"Preparar {DiasRango.Count} días";

    static bool Valida(string? d) => d != null && System.Text.RegularExpressions.Regex.IsMatch(d, @"^\d{4}-\d{2}-\d{2}$");

    protected override void OnParametersSet()
    {
        string? pedido = Valida(Fecha) ? Fecha : Valida(DiaQuery) ? DiaQuery : null;
        elegido = pedido ?? Fechas.Hoy;
        if (Fechas.Dif(elegido) >= 0)
        {
            desde = elegido;
            hasta = Fechas.Sumar(elegido, 6);
        }
    }

    Task Escribir(string texto) => E.TextoPlanAsync(elegido, texto);

    void CambiarAVarios()
    {
        varios = true;
        eligiendoFin = false;
    }

    /// <summary>Primer toque: el primer día. Segundo toque: el último (como al reservar un hotel).</summary>
    async Task TocarDia(string d)
    {
        if (!eligiendoFin || string.CompareOrdinal(d, desde) < 0)
        {
            desde = hasta = d;
            eligiendoFin = true;
        }
        else
        {
            int n = Fechas.Dif(d) - Fechas.Dif(desde) + 1;
            if (n > MaxDias)
            {
                d = Fechas.Sumar(desde, MaxDias - 1);
                E.MostrarAviso($"Como mucho {MaxDias} días a la vez");
            }
            hasta = d;
            eligiendoFin = false;
        }
        await E.SonarAsync("tic");
    }

    /// <summary>El texto de «varios días» repartido entre los días elegidos.</summary>
    Reparto Reparto => LectorDias.Repartir(textoRango, DiasRango);

    static string Juntar(string general, string propio) =>
        general.Length == 0 ? propio : propio.Length == 0 ? general : $"{general}, {propio}";

    /// <summary>Lo que se verá en la vista previa para un día, y si es suyo, general, de antes o libre.</summary>
    (string Texto, string Tipo) PlanPrevisto(string d)
    {
        var r = Reparto;
        if (r.PorDia.TryGetValue(d, out var propio)) return (Fechas.Cap(Juntar(r.General, propio).Length > 0 ? Juntar(r.General, propio) : "Lo que digas para este día"), "propio");
        if (TienePlan(d))
        {
            var p = E.D.Planes[d];
            string antes = !string.IsNullOrWhiteSpace(p.Texto) ? p.Texto : E.PlanDe(d)?.Etiqueta ?? "";
            return ($"{Fechas.Cap(antes)} (ya lo tenías)", "antes");
        }
        if (r.General.Length > 0) return (Fechas.Cap(r.General), "general");
        return ("Día tranquilo", "libre");
    }

    async Task Generar()
    {
        List<string> dias;
        if (!varios)
        {
            dias = new() { elegido };
        }
        else
        {
            dias = DiasRango;
            // Cada día recibe lo suyo: lo que has dicho para ese día (más lo general) o, si no lo nombras, lo general.
            // Los días que no nombras y ya tenían planes se quedan como estaban.
            var r = Reparto;
            foreach (var d in dias)
            {
                if (r.PorDia.TryGetValue(d, out var propio)) await E.PonerPlanAsync(d, Juntar(r.General, propio));
                else if (r.General.Length > 0 && !TienePlan(d)) await E.PonerPlanAsync(d, r.General);
            }
        }
        _ = E.GenerarSemanaAsync(dias);
        // Un día: te quedas aquí y ves cómo se prepara. Varios: al calendario, para ver cómo se rellenan los días.
        if (dias.Count > 1) Nav.NavigateTo($"calendario?dia={dias[0]}");
    }
}
