@page "/planificar"
@inherits PaginaCora

@* PLANIFICAR CON IA (reto 2): eliges el día, marcas los planes o los escribes,
   y decides si la IA prepara solo ese día o toda la semana. *@
<div class="pantalla">
    <div class="contenido">
        <Cabecera Volver="true" Titulo="Cuéntale tus planes" Sub="La IA preparará tu outfit" VolverA="calendario" />

        @* ¿Un día o toda la semana? Por defecto, solo el día elegido *@
        <div>
            <span class="etq">¿Qué quieres que prepare la IA?</span>
            <div class="segmentos" role="radiogroup" aria-label="Qué planificar">
                <button role="radio" class="@(soloDia ? "on" : "")" aria-checked="@(soloDia ? "true" : "false")" @onclick="() => soloDia = true">Solo este día</button>
                <button role="radio" class="@(!soloDia ? "on" : "")" aria-checked="@(!soloDia ? "true" : "false")" @onclick="() => soloDia = false">Toda la semana</button>
            </div>
        </div>

        @* Días: el elegido es blanco con borde (mismo criterio que los chips) *@
        <div class="selector-dias" role="group" aria-label="Días">
            @foreach (var d in Dias)
            {
                var dia = d;
                bool on = dia == elegido;
                <button class="@(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" aria-label="@(Fechas.Etiqueta(dia))" @onclick="() => elegido = dia">
                    <small>@Fechas.DiaCorto(dia)</small>
                    <b>@Fechas.De(dia).Day</b>
                    <i class="@(E.PlanDe(dia) != null ? "punto" : "")"></i>
                </button>
            }
        </div>

        <section class="tarjeta">
            <div class="fila"><span>@ServicioTiempo.Icono(W.Cielo)</span><span><b>@Fechas.Etiqueta(elegido)</b> · @W.T°, @W.Cielo</span></div>
            <div class="chips">
                @foreach (var t in DatosEjemplo.Planes)
                {
                    var tipo = t;
                    <Chip Texto="@tipo.Nombre" Activo="@(Plan.Claves.Contains(tipo.Clave))" OnClick="@(() => E.AlternarPlanAsync(elegido, tipo.Clave))" />
                }
            </div>
            <label class="campo">
                <span>O cuéntaselo con tus palabras</span>
                <textarea maxlength="200" rows="3" placeholder="Por ejemplo: clase por la mañana y gimnasio por la tarde" value="@Plan.Texto" @oninput="Escribir"></textarea>
            </label>
            <small class="sec derecha">@Plan.Texto.Length/200</small>
        </section>

        @* Aviso de qué días va a cambiar la IA, para que no haya sorpresas *@
        @if (soloDia)
        {
            <Caja Texto="@($"La IA preparará solo el outfit para {Cuando(elegido)}. El resto de la semana no se toca. Si hay varios planes ese día y hay que cambiarse (por ejemplo, para el deporte), te hará un conjunto para cada momento.")" />
        }
        else if (DiasConPlan.Count == 0)
        {
            <Caja Tipo="error" Texto="Ningún día de esta semana tiene planes todavía. Elige cada día arriba y cuéntale qué vas a hacer." />
        }
        else
        {
            <Caja Texto="@($"La IA preparará los días con planes: {ListaDias}. Los días sin planes no se tocan. Puedes elegir otro día arriba para añadirle planes.")" />
        }
    </div>
    <footer class="pie">
        <button class="btn" @onclick="Generar">@Iconos.Chispa @TextoBoton</button>
    </footer>
</div>

@code {
    [SupplyParameterFromQuery(Name = "dia")] public string? DiaInicial { get; set; }

    string elegido = Fechas.Hoy;
    bool soloDia = true;
    List<string> Dias = new();

    PlanDia Plan => E.D.Planes.TryGetValue(elegido, out var p) ? p : new PlanDia();
    Tiempo W => E.Tiempo.De(elegido);
    /// <summary>«hoy», «mañana» o «el lunes 16», para escribir frases naturales.</summary>
    static string Cuando(string d) => Fechas.Dif(d) <= 1 ? Fechas.Etiqueta(d).ToLower() : "el " + Fechas.Etiqueta(d).ToLower();

    List<string> DiasConPlan => Dias.Where(d => E.PlanDe(d) != null).ToList();
    string ListaDias => string.Join(", ", DiasConPlan.Select(Fechas.Etiqueta)).ToLower();

    string TextoBoton => soloDia
        ? $"Generar outfit para {Cuando(elegido)}"
        : DiasConPlan.Count == 1 ? "Generar la semana (1 día con planes)" : $"Generar la semana ({DiasConPlan.Count} días con planes)";

    protected override void OnParametersSet()
    {
        string baseDia = DiaInicial != null && System.Text.RegularExpressions.Regex.IsMatch(DiaInicial, @"^\d{4}-\d{2}-\d{2}$") && Fechas.Dif(DiaInicial) >= 0 ? DiaInicial : Fechas.Hoy;
        Dias = Fechas.Semana(baseDia).Where(d => Fechas.Dif(d) >= 0).ToList();
        elegido = baseDia;
    }

    Task Escribir(ChangeEventArgs e) => E.TextoPlanAsync(elegido, e.Value?.ToString() ?? "");

    async Task Generar()
    {
        var dias = soloDia ? new List<string> { elegido } : DiasConPlan;
        if (dias.Count == 0 || dias.Any(d => E.PlanDe(d) == null))
        {
            await E.SonarAsync("error");
            E.MostrarAviso(soloDia ? $"Cuéntale a Cora qué vas a hacer {Cuando(elegido)}." : "Cuéntale a Cora el plan de al menos un día.");
            return;
        }
        _ = E.GenerarSemanaAsync(dias);
        Nav.NavigateTo("calendario");
    }
}
