@page "/dia/{Fecha}"
@page "/planificar"
@inherits PaginaCora

@* UN DÍA DEL CALENDARIO: se llega tocando el día. Arriba, la ropa de ese día; debajo, los planes
   y qué quieres que prepare la IA (solo este día o toda la semana). Reto 2 (planificar con IA)
   y reto 3 (mientras la IA trabaja, la tarjeta se ve como un hueco gris y el botón cambia de mensaje). *@
<div class="pantalla">
    <div class="contenido">
        <Cabecera Volver="true" Titulo="@Fechas.Etiqueta(elegido)" Sub="@($"{Fechas.Cap(Fechas.Larga(elegido))} · {W.T}° {W.Cielo}")" VolverA="@($"calendario?dia={elegido}")" />

        @* ---- La ropa de ese día ---- *@
        <section class="tarjeta" aria-live="polite">
            <div class="entre"><h2>@E.T("Tu ropa", "Tu ropa")</h2><span>@ServicioTiempo.Icono(W.Cielo)</span></div>
            @if (E.EsperandoDia(elegido))
            {
                <EsperaIA Mensaje="@E.MensajeEspera" />
            }
            else if (E.PensandoDia == elegido)
            {
                <EsperaIA Mensaje="@E.MensajeOtra" />
            }
            else if (O != null)
            {
                if (!string.IsNullOrEmpty(O.Momento))
                {
                    <h3 class="momento">@O.Momento</h3>
                }
                <FilaOutfit Ids="O.Ids" Catalogo="E.D.Prendas" Animar="@(E.RecienRelleno(elegido))" @key="@(elegido + (E.RecienRelleno(elegido) ? "-nuevo" : ""))" />
                <p class="porque">@O.Porque</p>
                <LooksExtra O="O" Catalogo="E.D.Prendas" />
                if (!Pasado)
                {
                    <div class="fila">
                        <button class="btn secundario bajo extra" disabled="@(E.PensandoDia == elegido)" @onclick="() => E.OtraOpcionAsync(elegido)">@(E.PensandoDia == elegido ? "Pensando…" : E.T("Otra opción", "Ver otra"))</button>
                        <button class="btn secundario bajo" aria-pressed="@(DiaGuardado ? "true" : "false")" @onclick="() => E.AlternarGuardadoDiaAsync(elegido)">@Iconos.Marcador(DiaGuardado) @(DiaGuardado ? "Guardado ✓" : "Guardar")</button>
                    </div>
                }
            }
            else
            {
                <p class="sec">@(Pasado ? "Este día no tiene outfit registrado." : "Todavía sin outfit. Cuéntale tus planes a Cora y te lo prepara.")</p>
            }
        </section>

        @if (!Pasado)
        {
            @* ---- Planes de ese día ---- *@
            <section class="tarjeta">
                <h2>@E.T("¿Qué vas a hacer?", "¿Qué vas a hacer?")</h2>
                <div class="chips">
                    @foreach (var t in DatosEjemplo.Planes)
                    {
                        var tipo = t;
                        <Chip Texto="@tipo.Nombre" Activo="@(Plan.Claves.Contains(tipo.Clave))" OnClick="@(() => E.AlternarPlanAsync(elegido, tipo.Clave))" />
                    }
                </div>
                <label class="campo">
                    <span>O cuéntaselo con tus palabras</span>
                    <textarea maxlength="200" rows="3" placeholder="Por ejemplo: clase por la mañana y gimnasio por la tarde" value="@Plan.Texto" @oninput="Escribir"></textarea>
                </label>
                <small class="sec derecha">@Plan.Texto.Length/200</small>
            </section>

            @* ---- ¿Solo este día o toda la semana? (por defecto, solo este día) ---- *@
            <div>
                <span class="etq">¿Qué quieres que prepare la IA?</span>
                <div class="segmentos" role="radiogroup" aria-label="Qué planificar">
                    <button role="radio" class="@(soloDia ? "on" : "")" aria-checked="@(soloDia ? "true" : "false")" @onclick="() => soloDia = true">Solo este día</button>
                    <button role="radio" class="@(!soloDia ? "on" : "")" aria-checked="@(!soloDia ? "true" : "false")" @onclick="() => soloDia = false">Toda la semana</button>
                </div>
            </div>

            @if (!soloDia)
            {
                @* Para la semana: los demás días, por si quieres añadirles planes sin salir de aquí *@
                <div class="selector-dias" role="group" aria-label="Días de la semana">
                    @foreach (var d in Dias)
                    {
                        var dia = d;
                        bool on = dia == elegido;
                        <button class="@(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" aria-label="@(Fechas.Etiqueta(dia))" @onclick="() => Cambiar(dia)">
                            <small>@Fechas.DiaCorto(dia)</small>
                            <b>@Fechas.De(dia).Day</b>
                            <i class="@(E.PlanDe(dia) != null ? "punto" : "")"></i>
                        </button>
                    }
                </div>
                if (DiasConPlan.Count == 0)
                {
                    <Caja Tipo="error" Texto="Ningún día de esta semana tiene planes todavía. Toca cada día arriba y cuéntale qué vas a hacer." />
                }
                else
                {
                    <Caja Texto="@($"La IA preparará los días con planes: {ListaDias}. Los días sin planes no se tocan. Toca otro día arriba para añadirle planes.")" />
                }
            }
            else
            {
                <Caja Texto="@($"La IA preparará solo el outfit para {Cuando(elegido)}. El resto de la semana no se toca. Si ese día tienes que cambiarte (por ejemplo, para el deporte), te hará un conjunto para cada momento.")" />
            }
        }
    </div>
    @if (!Pasado)
    {
        <footer class="pie" aria-live="polite">
            @if (E.Generando)
            {
                <div class="btn ocupado">
                    <span>@(Clasica ? "Cargando…" : E.MensajeEspera)</span>
                    @if (!Clasica)
                    {
                        <span class="barra-progreso" style="width:@(E.Progreso)%"></span>
                    }
                </div>
            }
            else
            {
                <button class="btn" @onclick="Generar">@Iconos.Chispa @TextoBoton</button>
            }
        </footer>
    }
</div>

@code {
    [Parameter] public string? Fecha { get; set; }
    [SupplyParameterFromQuery(Name = "dia")] public string? DiaQuery { get; set; }

    string elegido = Fechas.Hoy;
    bool soloDia = true;
    List<string> Dias = new();

    PlanDia Plan => E.D.Planes.TryGetValue(elegido, out var p) ? p : new PlanDia();
    Outfit? O => E.OutfitDe(elegido);
    Tiempo W => E.Tiempo.De(elegido);
    bool Pasado => Fechas.Dif(elegido) < 0;
    bool DiaGuardado => E.DiaGuardado(elegido);
    bool Clasica => E.D.Ajustes.Espera == "clasica";
    /// <summary>«hoy», «mañana» o «el lunes 16», para escribir frases naturales.</summary>
    static string Cuando(string d) => Fechas.Dif(d) <= 1 ? Fechas.Etiqueta(d).ToLower() : "el " + Fechas.Etiqueta(d).ToLower();

    List<string> DiasConPlan => Dias.Where(d => E.PlanDe(d) != null).ToList();
    string ListaDias => string.Join(", ", DiasConPlan.Select(Fechas.Etiqueta)).ToLower();

    string TextoBoton => soloDia
        ? (O != null ? $"Preparar otro outfit para {Cuando(elegido)}" : $"Preparar el outfit de {Cuando(elegido)}")
        : DiasConPlan.Count == 1 ? "Preparar la semana (1 día con planes)" : $"Preparar la semana ({DiasConPlan.Count} días con planes)";

    static bool Valida(string? d) => d != null && System.Text.RegularExpressions.Regex.IsMatch(d, @"^\d{4}-\d{2}-\d{2}$");

    protected override void OnParametersSet()
    {
        string? pedido = Valida(Fecha) ? Fecha : Valida(DiaQuery) ? DiaQuery : null;
        Cambiar(pedido ?? Fechas.Hoy);
    }

    void Cambiar(string dia)
    {
        elegido = dia;
        Dias = Fechas.Semana(dia).Where(d => Fechas.Dif(d) >= 0).ToList();
    }

    Task Escribir(ChangeEventArgs e) => E.TextoPlanAsync(elegido, e.Value?.ToString() ?? "");

    async Task Generar()
    {
        var dias = soloDia ? new List<string> { elegido } : DiasConPlan;
        if (dias.Count == 0 || dias.Any(d => E.PlanDe(d) == null))
        {
            await E.SonarAsync("error");
            E.MostrarAviso(soloDia ? $"Cuéntale a Cora qué vas a hacer {Cuando(elegido)}." : "Cuéntale a Cora el plan de al menos un día.");
            return;
        }
        _ = E.GenerarSemanaAsync(dias);
        // Un día: te quedas aquí y ves cómo se prepara. La semana: al calendario, para ver cómo se rellenan los días.
        if (!soloDia) Nav.NavigateTo($"calendario?dia={elegido}");
    }
}
