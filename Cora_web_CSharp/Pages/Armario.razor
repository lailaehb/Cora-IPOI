@page "/armario"
@inherits PaginaCora

@* MI ARMARIO: categorías (cada una abre su pantalla), favoritas y añadidas hace poco. *@
<div class="pantalla">
    <div class="contenido">
        <Cabecera Titulo="@E.T("Mi armario", "Mi ropa")" Sub="@($"{E.D.Prendas.Count} prendas")" Avatar="true" />
        @* Cuatro cuadrados: cesto, lavadora, probador y números. Cada uno con su color para que no parezca todo igual. *@
        <div class="cuadros">
            <a class="cuadro tinte-melocoton @(E.TocaLavadoraHoy && E.EnCesto.Count > 0 ? "llama" : "")" href="cesto">
                <span class="cuadro-ico">@Iconos.Cesto</span>
                @if (E.EnCesto.Count > 0)
                {
                    <span class="cuadro-num">@E.EnCesto.Count</span>
                }
                <b>@E.T("Cesto", "Ropa sucia")</b>
                <small>@(E.EnCesto.Count == 0 ? "Vacío" : E.TocaLavadoraHoy ? "¡Hoy toca lavadora!" : E.EnCesto.Count == 1 ? "1 prenda sucia" : $"{E.EnCesto.Count} prendas sucias")</small>
            </a>
            <a class="cuadro tinte-lavanda @(E.Secas.Count > 0 ? "llama" : "")" href="categoria/lavadora">
                <span class="cuadro-ico aro-lavadora @(E.Secas.Count > 0 ? "seca" : "")" style="--avance:@(AvanceLavadora)">
                    <span class="@(E.EnLavadora.Count > 0 && E.Secas.Count == 0 ? "girando" : "")">@Iconos.Lavadora</span>
                </span>
                @if (E.EnLavadora.Count > 0)
                {
                    <span class="cuadro-num">@E.EnLavadora.Count</span>
                }
                <b>Lavadora</b>
                <small>@(E.EnLavadora.Count == 0 ? "Vacía" : E.Secas.Count > 0 ? (E.Secas.Count == 1 ? "1 ya está seca" : $"{E.Secas.Count} ya están secas") : $"Lista en {Estado.TextoFalta(E.EnLavadora.Min(Estado.Falta))}")</small>
            </a>
            <a class="cuadro tinte-rosa" href="probador">
                <span class="cuadro-ico">@Iconos.Probador</span>
                <b>Probador</b>
                <small>Monta tu look deslizando</small>
            </a>
            <a class="cuadro tinte-menta extra" href="estadisticas">
                <span class="cuadro-ico">@Iconos.Grafica</span>
                <b>En números</b>
                <small>@(olvidadas == 0 ? "Lo que más usas" : $"{olvidadas} olvidadas")</small>
            </a>
        </div>

        <div class="seccion"><h2>Categorías</h2></div>
        <div class="categorias">
            @foreach (var c in Enum.GetValues<Categoria>())
            {
                var lista = E.D.Prendas.Where(p => p.Cat == c).ToList();
                <a class="tarjeta categoria" href="@($"categoria/{c.ToString().ToLower()}")" aria-label="@($"{DatosEjemplo.NombreCat[c]}, {lista.Count} prendas")">
                    <span class="tres">
                        @for (int i = 0; i < 3; i++)
                        {
                            if (i < lista.Count)
                            {
                                <FotoPrenda P="@(lista[i])" />
                            }
                            else
                            {
                                <span class="foto vacia"></span>
                            }
                        }
                    </span>
                    <b>@(DatosEjemplo.NombreCat[c])</b>
                    <small>@lista.Count @(lista.Count == 1 ? "prenda" : "prendas")</small>
                </a>
            }
        </div>

        @if (Favoritas.Count > 0)
        {
            <div class="seccion"><h2>Favoritas</h2><a href="guardados?tab=prendas">Ver todas</a></div>
            <div class="estante">
                @foreach (var p in Favoritas)
                {
                    var id = p.Id;
                    <TarjetaPrenda P="p" Favorita="true" OnClick="@(() => Ir($"prenda/{id}"))" />
                }
            </div>
        }

        <div class="seccion extra"><h2>Añadidas hace poco</h2></div>
        <div class="estante extra">
            @foreach (var p in Enumerable.Reverse(E.D.Prendas).Take(6))
            {
                var id = p.Id;
                <TarjetaPrenda P="p" Favorita="@(E.EsFavorita(id))" OnClick="@(() => Ir($"prenda/{id}"))" />
            }
        </div>
    </div>
</div>

@code {
    int olvidadas;
    protected override void OnInitialized() => olvidadas = E.Olvidadas().Count;
    /// <summary>Lo que lleva lavado la prenda que antes termina (de 0 a 100), para el anillo del cuadrado.</summary>
    string AvanceLavadora => E.EnLavadora.Count == 0 ? "0" : ((int)(E.EnLavadora.Max(Estado.FraccionLavado) * 100)).ToString();
    List<Prenda> Favoritas => E.D.Prendas.Where(p => E.EsFavorita(p.Id)).ToList();
}
