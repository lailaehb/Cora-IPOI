{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"No hace falta instalar nada con npm\"",
  "buildCommand": "bash vercel-build.sh",
  "outputDirectory": "salida/wwwroot",
  "functions": { "api/ia.js": { "maxDuration": 60 }, "api/producto.js": { "maxDuration": 20 } },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
