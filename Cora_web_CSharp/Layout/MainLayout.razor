@inherits LayoutComponentBase
@implements IDisposable
@inject Estado E
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="escenario">
    <main class="movil @E.ClasesAccesibilidad">
        @if (!E.Listo)
        {
            <div class="arranque">Cora</div>
        }
        else
        {
            <div class="vista">@Body</div>
            if (EsPrincipal)
            {
                <nav class="barra" aria-label="Secciones">
                    <a href="" class="pestana @(Ruta == "" ? "activa" : "")" aria-current="@(Ruta == "" ? "page" : null)">@Iconos.Casa<span>Inicio</span></a>
                    <a href="armario" class="pestana @(Ruta == "armario" ? "activa" : "")" aria-current="@(Ruta == "armario" ? "page" : null)">@Iconos.Percha<span>@E.T("Armario", "Mi ropa")</span></a>
                    <a href="anadir" class="pestana mas" aria-label="Añadir prenda"><span class="circulo">@Iconos.Mas</span><span>@E.T("Añadir", "Añadir ropa")</span></a>
                    <a href="calendario" class="pestana @(Ruta == "calendario" ? "activa" : "")" aria-current="@(Ruta == "calendario" ? "page" : null)">@Iconos.Calendario<span>@E.T("Calendario", "Mis días")</span></a>
                    @if (E.D.Ajustes.MenosOpciones)
                    {
                        @* Modo fácil: sin Explorar (es para ver a otras personas); el perfil y los ajustes, a mano *@
                        <a href="perfil" class="pestana @(Ruta == "perfil" ? "activa" : "")" aria-current="@(Ruta == "perfil" ? "page" : null)">@Iconos.Persona<span>Mi perfil</span></a>
                    }
                    else
                    {
                        <a href="explorar" class="pestana @(Ruta == "explorar" ? "activa" : "")" aria-current="@(Ruta == "explorar" ? "page" : null)">@Iconos.Globo<span>Explorar</span></a>
                    }
                </nav>
            }
        }
        <div class="toast @(E.TextoAviso != null ? "visible" : "")" role="status" aria-live="polite">@E.TextoAviso</div>
    </main>
</div>

@code {
    static readonly string[] Principales = { "", "armario", "anadir", "calendario", "explorar" };

    string Ruta => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
    // En modo fácil, «Mi perfil» es una pestaña más, así que también lleva la barra de abajo
    bool EsPrincipal => Principales.Contains(Ruta) || (Ruta == "perfil" && E.D.Ajustes.MenosOpciones);

    protected override void OnInitialized()
    {
        E.Cambio += Repintar;
        Nav.LocationChanged += AlNavegar;
    }

    protected override async Task OnAfterRenderAsync(bool primeraVez)
    {
        if (primeraVez)
        {
            await E.CargarAsync();
            ComprobarRegistro();
        }
        // Idioma: se aplica al cargar y cada vez que se cambia en Configuración (lo traduce js/idiomas.js)
        if (E.Listo && E.D.Ajustes.Idioma != idiomaPuesto)
        {
            idiomaPuesto = E.D.Ajustes.Idioma;
            try { await JS.InvokeVoidAsync("coraIdiomas.poner", idiomaPuesto); } catch { }
        }
    }

    string? idiomaPuesto;

    void AlNavegar(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        ComprobarRegistro();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Si la persona aún no se ha registrado, la lleva al registro; y si ya lo está y abre la página de registro
    /// (por ejemplo, porque añadió la app a la pantalla de inicio estando en el registro), la lleva al inicio.
    /// </summary>
    void ComprobarRegistro()
    {
        if (!E.Listo) return;
        if (!E.D.Perfil.Registrada && Ruta != "registro") Nav.NavigateTo("registro", replace: true);
        else if (E.D.Perfil.Registrada && Ruta == "registro") Nav.NavigateTo("", replace: true);
    }

    void Repintar() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        E.Cambio -= Repintar;
        Nav.LocationChanged -= AlNavegar;
    }
}
